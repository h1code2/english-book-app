<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EnglishNotebook" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <style name="FilterChip" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_chip_toggle</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <!-- 工具栏作用域覆盖：溢出菜单「⋮」等框架图标在品牌蓝底上保持白色 -->
    <style name="ThemeOverlay.EnglishNotebook.Toolbar" parent="">
        <item name="colorControlNormal">@android:color/white</item>
    </style>
</resources>
